---
/**
 * COLLECTION DETAIL — shared by both languages.
 * Rendered once per collection by the [slug] routes.
 */
import Layout from '../../layouts/Layout.astro';
import Figure from '../Figure.astro';
import { site } from '../../data/site.js';
import { t, path as routePath, collectionPath } from '../../data/i18n.js';
import { asset } from '../../lib/asset.js';

interface Props {
  collection: any;
  prev: any;
  next: any;
  lang: 'sr' | 'en';
  altHref: string;
}
const { collection, prev, next, lang, altHref } = Astro.props;

const s = t(lang);
const c = s.collection;

// Carries the chosen collection into the booking form, so the dropdown
// arrives pre-filled and she doesn't have to pick it twice.
const bookingLink = `${routePath('booking', lang)}?kolekcija=${collection.slug}`;

// Slimmed-down copy of the gown data for the client-side lightbox.
// Only what the gallery actually needs — no descriptions, no other languages.
const galleryData = collection.gowns.map((g: any) => ({
  name: g.name,
  alt: g.alt[lang],
  images: (g.images ?? []).map(asset),
  video: asset(g.video ?? ''),
}));
---

<Layout
  title={`${collection.name} — ${s.collections.metaTitle}`}
  description={`${collection.short[lang]} ${collection.name} — ${site.parentBrand}, ${site.name}, ${site.address.city}.`}
  lang={lang}
  altHref={altHref}
>
  <section class="head">
    <div class="container head__inner">
      <nav class="crumbs" aria-label={c.breadcrumbAria}>
        <a href={routePath('collections', lang)}>{c.breadcrumb}</a>
        <span aria-hidden="true">·</span>
        <span>{collection.name}</span>
      </nav>

      <h1>{collection.name}</h1>
      <p class="head__short">{collection.short[lang]}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container intro">
      <div class="intro__text" data-reveal>
        <span class="eyebrow">{c.aboutEyebrow}</span>
        <p>{collection.description[lang]}</p>
        <a href={bookingLink} class="link-underline">{c.bookForThis}</a>
      </div>

      <div class="intro__media" data-reveal>
        <Figure
          src={collection.cover}
          alt={`${collection.name} — ${site.parentBrand}`}
          ratio="4/5"
          label={collection.name}
        />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <header class="gallery__head" data-reveal>
        <span class="eyebrow">{c.gownsEyebrow}</span>
        <h2>{c.gownsTitle}</h2>
        <p>{c.gownsNote}</p>
      </header>

      <div class="gallery">
        {collection.gowns.map((gown: any, i: number) => {
          const shots = gown.images ?? [];
          const count = shots.length + (gown.video ? 1 : 0);
          return (
            <figure class="gown" data-reveal>
              {/* The whole card is one button — click opens the gown's gallery. */}
              <button
                type="button"
                class="gown__btn"
                data-gown={i}
                aria-label={`${gown.name} — ${c.galleryOpen}`}
              >
                <Figure src={shots[0] ?? ''} alt={gown.alt[lang]} ratio="3/4" label={gown.name} />
                {count > 1 && (
                  <span class="gown__badge" aria-hidden="true">
                    {gown.video ? `${shots.length} + ${c.galleryVideo}` : shots.length}
                  </span>
                )}
              </button>
              <figcaption>
                <span class="gown__name">{gown.name}</span>
                {count > 1 && <span class="gown__count">{c.galleryPhotoCount(shots.length)}</span>}
              </figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  {/*
    LIGHTBOX — one per page, filled in by JS when a gown is clicked.
    Hidden entirely until opened, so it costs nothing on first paint.
  */}
  <div
    class="lb"
    data-lightbox
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={c.galleryAria}
  >
    <div class="lb__bar">
      <span class="lb__title" data-lb-title></span>
      <span class="lb__pos" data-lb-pos></span>
      <button type="button" class="lb__close" data-lb-close aria-label={c.galleryClose}>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="lb__stage" data-lb-stage>
      <button type="button" class="lb__nav lb__nav--prev" data-lb-prev aria-label={c.galleryPrev}>
        <span aria-hidden="true">&#8249;</span>
      </button>
      <div class="lb__frame" data-lb-frame></div>
      <button type="button" class="lb__nav lb__nav--next" data-lb-next aria-label={c.galleryNext}>
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>

    <div class="lb__thumbs" data-lb-thumbs></div>
  </div>

  <section class="cta-band">
    <div class="container cta-band__inner" data-reveal>
      <span class="eyebrow">{c.ctaEyebrow}</span>
      <h2>{c.ctaTitleBefore} {collection.name}<br />{c.ctaTitleAfter}</h2>
      <p>{c.ctaText}</p>
      <div class="cta-band__actions">
        <a href={bookingLink} class="btn">{s.bookCta}</a>
        <a href={`tel:${site.phoneHref}`} class="cta-band__phone">{site.phone}</a>
      </div>
    </div>
  </section>

  <nav class="pager" aria-label={c.pagerAria}>
    <div class="container pager__inner">
      <a href={collectionPath(prev.slug, lang)} class="pager__link pager__link--prev">
        <span class="pager__label">{c.prev}</span>
        <span class="pager__name">{prev.name}</span>
      </a>
      <a href={collectionPath(next.slug, lang)} class="pager__link pager__link--next">
        <span class="pager__label">{c.next}</span>
        <span class="pager__name">{next.name}</span>
      </a>
    </div>
  </nav>
</Layout>

<script define:vars={{ galleryData, sep: c.gallerySeparator }}>
  /**
   * GOWN GALLERY
   *
   * Click a gown → full-screen lightbox with every photo of that gown.
   * Keyboard: ← → to move, Esc to close. Swipe works on touch.
   *
   * Re-initialised on every page load because view transitions keep the
   * document alive between pages — a one-off listener would go stale.
   */
  function initGallery() {
    const box = document.querySelector('[data-lightbox]');
    if (!box) return;

    const frame = box.querySelector('[data-lb-frame]');
    const title = box.querySelector('[data-lb-title]');
    const pos = box.querySelector('[data-lb-pos]');
    const thumbs = box.querySelector('[data-lb-thumbs]');

    let slides = [];
    let index = 0;
    let opener = null;
    /** The <img> or <video> currently in the frame, held so the pan
        handlers do not re-query the DOM on every move event. */
    let current = null;

    /* ── Zoom ──────────────────────────────────────────────────
       scale 1 = the whole photo fits. Above that we translate the
       image to pan around it. Wheel and click zoom on desktop,
       pinch and tap on touch. Reset on every slide change.       */
    /* Capped at 3: the zoom-resolution file is 3200px on its long edge,
       so past this the browser is only enlarging blur, not revealing lace. */
    const MAX_ZOOM = 3;
    const TAP_ZOOM = 2.5;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let hiResDone = false;

    /*
      Every gown photo ships in three cuts, named by suffix:
        name.jpg        1600px — the gallery view
        name@2x.jpg     3200px — swapped in when someone zooms
        name@thumb.jpg   160px — the strip along the bottom
      Adding a photo means adding all three. This is the only place the
      naming is encoded, so it is also the only place to change it.
    */
    const variant = (src, suffix) => src.replace(/\.jpg$/, `${suffix}.jpg`);
    const thumbSrc = (src) => variant(src, '@thumb');

    /**
     * The gallery ships 1600px photos so the first view is quick. That is
     * not enough pixels once zoomed, so the first time someone zooms we
     * fetch the 3200px twin and swap it in. Same element, so the current
     * transform survives; by then the file is cached, so there is no flash.
     */
    const loadHiRes = () => {
      if (hiResDone) return;
      const el = frame.firstElementChild;
      if (!el || el.tagName !== 'IMG') return;

      const big = variant(el.getAttribute('src'), '@2x');
      if (big === el.getAttribute('src')) return;

      hiResDone = true; // only ever attempt once per slide
      const pre = new Image();
      pre.onload = () => {
        // Guard against the visitor having moved on while it downloaded.
        if (frame.firstElementChild === el) el.src = big;
      };
      pre.src = big; // on failure we simply keep the smaller photo
    };

    /*
      How far the photo may be dragged, at scale 1, on each axis.

      Because of object-fit: contain the photo is letterboxed inside the
      frame, so the element's own box is the wrong thing to clamp against —
      the real size has to come from the natural dimensions. That involves
      reading layout, which is why it is measured once per slide and per
      resize rather than inside the pan handlers: recomputing it there
      forced a style recalc on every one of the ~60 move events a second.
    */
    let fitted = { w: 0, h: 0, fw: 0, fh: 0 };

    const measure = () => {
      const el = frame.firstElementChild;
      const fw = frame.clientWidth;
      const fh = frame.clientHeight;
      // While the dialog is still hidden (fw/fh 0) or the photo has not
      // loaded yet (natural size 0), dividing produces NaN — which would
      // poison tx/ty for good, because the browser silently ignores a
      // translate(NaNpx) and NaN survives every later min/max. Fall back
      // to "no pan range" until real numbers exist.
      const nw = el ? el.naturalWidth || el.videoWidth || 0 : 0;
      const nh = el ? el.naturalHeight || el.videoHeight || 0 : 0;
      const fit = nw && nh && fw && fh ? Math.min(fw / nw, fh / nh) : 0;
      fitted = fit ? { w: nw * fit, h: nh * fit, fw, fh } : { w: fw, h: fh, fw, fh };
    };

    /** Keep the photo from being dragged away past its own edges. */
    const clampPan = () => {
      const maxX = Math.max(0, (fitted.w * scale - fitted.fw) / 2);
      const maxY = Math.max(0, (fitted.h * scale - fitted.fh) / 2);
      tx = Math.min(maxX, Math.max(-maxX, tx));
      ty = Math.min(maxY, Math.max(-maxY, ty));
      // Belt and braces: never let a stray non-finite value through.
      if (!Number.isFinite(tx)) tx = 0;
      if (!Number.isFinite(ty)) ty = 0;
    };

    const applyZoom = () => {
      clampPan();
      if (current) current.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      frame.classList.toggle('is-zoomed', scale > 1);
      if (scale > 1) loadHiRes();
    };

    const resetZoom = () => {
      scale = 1;
      tx = 0;
      ty = 0;
      measure();
      applyZoom();
    };

    /** Zoom towards a screen point so it stays under the cursor/finger. */
    const zoomTo = (next, clientX, clientY) => {
      const target = Math.min(MAX_ZOOM, Math.max(1, next));
      const r = frame.getBoundingClientRect();
      const px = clientX - (r.left + r.width / 2);
      const py = clientY - (r.top + r.height / 2);
      tx = px - ((px - tx) * target) / scale;
      ty = py - ((py - ty) * target) / scale;
      scale = target;
      if (scale === 1) {
        tx = 0;
        ty = 0;
      }
      applyZoom();
    };

    /** Video (if any) comes first, then the photographs. */
    const buildSlides = (gown) => {
      const list = gown.video ? [{ type: 'video', src: gown.video }] : [];
      gown.images.forEach((src) => list.push({ type: 'image', src }));
      return list;
    };

    const render = () => {
      const slide = slides[index];
      frame.innerHTML = '';

      if (slide.type === 'video') {
        const v = document.createElement('video');
        v.src = slide.src;
        v.controls = true;
        v.playsInline = true;
        v.preload = 'metadata';
        frame.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = slide.src;
        img.alt = title.textContent || '';
        frame.appendChild(img);
      }

      current = frame.firstElementChild;
      // Natural size is unknown until the file arrives, so measure again
      // once it does — the first measure only gets the frame right.
      current.addEventListener('loadedmetadata', measure, { once: true });
      current.addEventListener('load', measure, { once: true });

      // Every new slide starts fitted, never mid-zoom, and back on the
      // small file so the next zoom re-fetches the @2x for THIS photo.
      hiResDone = false;
      resetZoom();

      pos.textContent = `${index + 1} ${sep} ${slides.length}`;

      // Highlight the active thumbnail and keep it in view.
      thumbs.querySelectorAll('button').forEach((b, i) => {
        const on = i === index;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-current', on ? 'true' : 'false');
        if (on) b.scrollIntoView({ block: 'nearest', inline: 'center' });
      });

      // Quietly warm up the neighbours so paging feels instant.
      [index - 1, index + 1].forEach((i) => {
        const n = slides[i];
        if (n && n.type === 'image') new Image().src = n.src;
      });
    };

    const go = (delta) => {
      index = (index + delta + slides.length) % slides.length;
      render();
    };

    const buildThumbs = () => {
      thumbs.innerHTML = '';
      slides.forEach((slide, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'lb__thumb';
        b.setAttribute('aria-label', `${i + 1} ${sep} ${slides.length}`);
        if (slide.type === 'video') {
          b.classList.add('lb__thumb--video');
          b.innerHTML = '<span aria-hidden="true">&#9654;</span>';
        } else {
          const img = document.createElement('img');
          // The strip renders these at 52×70, so it takes the @thumb cut.
          // Pointing it at the full photo made opening one gown pull the
          // whole gallery at full size — 2.5 MB and ten 1600px decodes for
          // Emily alone, before the main photo had even started.
          img.src = thumbSrc(slide.src);
          img.alt = '';
          img.loading = 'lazy';
          b.appendChild(img);
        }
        b.addEventListener('click', () => {
          index = i;
          render();
        });
        thumbs.appendChild(b);
      });
    };

    // Pending fade-out timer. Reopening before it fires must cancel it,
    // otherwise it wipes the frame of the gallery that just opened.
    let closeTimer = null;

    const open = (gownIndex, trigger) => {
      const gown = galleryData[gownIndex];
      if (!gown || !gown.images.length) return;

      clearTimeout(closeTimer);
      closeTimer = null;

      opener = trigger;
      slides = buildSlides(gown);
      index = 0;
      title.textContent = gown.name;

      buildThumbs();
      render();

      box.hidden = false;
      // Next frame, so the fade-in transition actually runs.
      requestAnimationFrame(() => box.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      box.querySelector('[data-lb-close]').focus();
    };

    const close = () => {
      box.classList.remove('is-open');
      document.body.style.overflow = '';

      const finish = () => {
        closeTimer = null;
        box.hidden = true;
        frame.innerHTML = ''; // stops any playing video
        if (opener) opener.focus();
        opener = null;
      };

      // Wait for the fade-out unless the visitor asked for less motion.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
      else closeTimer = setTimeout(finish, 220);
    };

    document.querySelectorAll('[data-gown]').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.gown), btn));
    });

    box.querySelector('[data-lb-close]').addEventListener('click', close);
    box.querySelector('[data-lb-prev]').addEventListener('click', () => go(-1));
    box.querySelector('[data-lb-next]').addEventListener('click', () => go(1));

    // Clicking the backdrop closes; clicking the photo itself does not.
    box.querySelector('[data-lb-stage]').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) close();
    });

    // Bound to the dialog itself, not the document: focus lives inside it
    // while open, and the listener dies with the element on page change.
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
      else if (e.key === '+' || e.key === '=') zoomAtCentre(scale * 1.5);
      else if (e.key === '-') zoomAtCentre(scale / 1.5);
      else if (e.key === '0') resetZoom();
      else if (e.key === 'Tab') {
        // Keep focus inside the dialog while it is open.
        const focusable = box.querySelectorAll('button');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    /** Keyboard zoom works from the middle of the frame. */
    function zoomAtCentre(next) {
      const r = frame.getBoundingClientRect();
      zoomTo(next, r.left + r.width / 2, r.top + r.height / 2);
    }

    // ── Mouse: wheel to zoom, click to toggle, drag to pan ──────
    frame.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        zoomTo(scale * (e.deltaY < 0 ? 1.18 : 1 / 1.18), e.clientX, e.clientY);
      },
      { passive: false },
    );

    let dragging = false;
    let moved = false;
    let dragX = 0;
    let dragY = 0;

    frame.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || scale === 1) return; // touch handled below
      dragging = true;
      moved = false;
      dragX = e.clientX;
      dragY = e.clientY;
      frame.classList.add('is-grabbing');
      frame.setPointerCapture(e.pointerId);
    });

    frame.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragX;
      const dy = e.clientY - dragY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
      tx += dx;
      ty += dy;
      dragX = e.clientX;
      dragY = e.clientY;
      applyZoom();
    });

    const endDrag = () => {
      dragging = false;
      frame.classList.remove('is-grabbing');
    };
    frame.addEventListener('pointerup', endDrag);
    frame.addEventListener('pointercancel', endDrag);

    frame.addEventListener('click', (e) => {
      if (moved) {
        moved = false; // that click was the end of a drag, not a real click
        return;
      }
      if (scale > 1) resetZoom();
      else zoomTo(TAP_ZOOM, e.clientX, e.clientY);
    });

    // ── Touch: pinch to zoom, drag to pan, swipe to change photo ──
    let startX = 0;
    let startY = 0;
    let pinchDist = 0;
    let pinchScale = 1;
    let panX = 0;
    let panY = 0;

    const touchDist = (t) =>
      Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
    const touchMid = (t) => ({
      x: (t[0].clientX + t[1].clientX) / 2,
      y: (t[0].clientY + t[1].clientY) / 2,
    });

    box.addEventListener(
      'touchstart',
      (e) => {
        moved = false; // a fresh gesture starts as a potential tap
        if (e.touches.length === 2) {
          pinchDist = touchDist(e.touches);
          pinchScale = scale;
        } else {
          startX = panX = e.changedTouches[0].clientX;
          startY = panY = e.changedTouches[0].clientY;
        }
      },
      { passive: true },
    );

    box.addEventListener(
      'touchmove',
      (e) => {
        // Either gesture ends with a click event we must not treat as a tap.
        // `moved` doubles as the "already set up this gesture" latch, so the
        // class is written once per gesture rather than on every move event —
        // classList.add rewrites the attribute even when nothing changes,
        // which dirties style ~60 times a second for no reason.
        if (!moved) {
          moved = true;
          // Drop the easing so the photo tracks the finger exactly.
          frame.classList.add('is-grabbing');
        }

        if (e.touches.length === 2) {
          e.preventDefault();
          const mid = touchMid(e.touches);
          zoomTo((pinchScale * touchDist(e.touches)) / pinchDist, mid.x, mid.y);
        } else if (scale > 1) {
          // Zoomed in, so a one-finger drag pans instead of paging.
          e.preventDefault();
          const t = e.touches[0];
          tx += t.clientX - panX;
          ty += t.clientY - panY;
          panX = t.clientX;
          panY = t.clientY;
          applyZoom();
        }
      },
      { passive: false },
    );

    box.addEventListener(
      'touchend',
      (e) => {
        if (!e.touches.length) frame.classList.remove('is-grabbing');
        if (scale > 1 || e.touches.length) return; // panning or still pinching
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    // The frame changes size with the window, and the pan limits are
    // derived from it — so they have to be taken again, but only here
    // rather than on every move event.
    addEventListener('resize', () => {
      if (box.hidden) return;
      measure();
      applyZoom();
    });
  }

  /*
    One call, no astro:page-load listener.

    define:vars forces this script inline, and Astro re-executes inline
    scripts on every view transition — so this line already runs once per
    page view, against that page's own markup and galleryData.

    Adding a listener on top would be worse than redundant: it would leave
    one behind per page viewed, and each stale closure still holds the
    gowns of the collection it was created for, so a later transition would
    open the gallery of the previous collection.
  */
  initGallery();
</script>

<style>
  .head {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 4.5rem));
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    background: var(--ivory-deep);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .crumbs a { color: var(--gold-deep); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .head__short {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 3vw, 1.6rem);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 34ch;
    margin-top: 1.25rem;
  }

  .section--tight { padding-block: clamp(3.5rem, 8vw, 6rem); }

  .intro { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
  .intro__text p {
    font-size: 1.0625rem;
    line-height: 1.9;
    max-width: var(--max-prose);
    margin-bottom: 1.75rem;
  }

  .gallery__head { margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .gallery__head h2 { margin-bottom: 1.25rem; }
  .gallery__head p { max-width: 52ch; line-height: 1.8; }

  .gallery { display: grid; gap: clamp(1.75rem, 4vw, 2.5rem); }
  .gown { margin: 0; }

  /* The card is a button, so strip the browser's chrome off it. */
  .gown__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
    text-align: left;
  }
  /* Only the offset differs from the global focus ring — the card is big
     enough that 3px reads as touching the photo. */
  .gown__btn:focus-visible { outline-offset: 4px; }

