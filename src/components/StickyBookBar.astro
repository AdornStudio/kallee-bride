---
/**
 * StickyBookBar — mobile only.
 *
 * A calm bar pinned to the bottom of the screen on phones, so a bride
 * can call or book from anywhere on the site without scrolling back up.
 * It slides in only after she has scrolled past the hero, so it never
 * covers the first impression.
 *
 * Hidden automatically on the booking page itself (she's already there).
 */
import { site } from '../data/site.js';
import { t, path as routePath, routes } from '../data/i18n.js';

interface Props {
  lang: 'sr' | 'en';
}
const { lang } = Astro.props;
const s = t(lang);

// Both booking paths, so the script can hide the bar on either language's
// booking page without hard-coding the Serbian one.
const bookingPaths = [routes.booking.sr, routes.booking.en];
---

<div class="bookbar" data-bookbar aria-hidden="false">
  <a href={`tel:${site.phoneHref}`} class="bookbar__call">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6
               19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2
               2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57
               2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    <span>{s.callCta}</span>
  </a>

  <a href={routePath('booking', lang)} class="bookbar__book">{s.bookCta}</a>
</div>

<style>
  .bookbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: flex;
    align-items: stretch;
    background: var(--ivory);
    border-top: 1px solid var(--line);
    /* Sits above the iPhone home-indicator bar. */
    padding-bottom: env(safe-area-inset-bottom, 0);
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bookbar.is-visible { transform: none; }

  .bookbar__call,
  .bookbar__book {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 58px;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .bookbar__call {
    flex: 0 0 38%;
    color: var(--ink);
    border-right: 1px solid var(--line);
  }

  .bookbar__book {
    flex: 1;
    background: var(--ink);
    color: var(--ivory);
  }

  /* Desktop has the header CTA always visible — no bar needed. */
  @media (min-width: 900px) {
    .bookbar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bookbar { transition: none; }
  }
</style>

<script define:vars={{ bookingPaths }}>
  // Re-pointed at the new page's bar after each navigation.
  let bar = null;

  // Registered once on window so navigating never stacks up listeners.
  const toggle = () => {
    // Appear once she's scrolled roughly past the first screen.
    bar?.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6);
  };
  window.addEventListener('scroll', toggle, { passive: true });

  function initBookBar() {
    bar = document.querySelector('[data-bookbar]');

    // Don't show the bar on either language's booking page — she's already there.
    const here = window.location.pathname.replace(/\/$/, '');
    if (bar && bookingPaths.some((p) => here === p.replace(/\/$/, ''))) {
      bar.remove();
      bar = null;
      return;
    }
    toggle();
  }

  document.addEventListener('astro:page-load', initBookBar);
</script>
